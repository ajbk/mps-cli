MPS_API_BASE_URL=https://mps-api.example.com
MPS_RESOURCE_URL=https://mps-mcp.example.com/mcp
MPS_OAUTH_ISSUER=https://auth.example.com
MPS_OAUTH_INTROSPECTION_URL=https://auth.example.com/oauth/introspect
MPS_OAUTH_CLIENT_ID=configure-in-environment
MPS_OAUTH_CLIENT_SECRET=configure-in-environment
# Server-only token shared with the MPS API as MPS_MCP_SERVICE_TOKEN.
MPS_API_SERVICE_TOKEN=configure-in-environment
# Maximum JSON-RPC request body size before parsing/authentication.
MPS_MCP_MAX_BODY_BYTES=65536
